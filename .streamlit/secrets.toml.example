# --- Esempio di secrets per il deploy su Streamlit Community Cloud ---
# NON committare il vero secrets.toml (è già in .gitignore).
# Su Streamlit Cloud: app → Settings → Secrets → incolla queste righe con i valori reali.

# Attiva la modalità demo pubblica (provider/modello/chiave presi da qui,
# campi sensibili nascosti, limite di domande per sessione).
DEMO_MODE = "true"
DEMO_MAX_QUESTIONS = "15"

# Provider consigliato per la demo: Groq ha un tier GRATUITO affidabile (nessuna carta).
# Chiave da https://console.groq.com/keys
PROVIDER = "groq"
MODEL = "llama-3.3-70b-versatile"

# Metti SOLO la chiave del provider scelto sopra:
GROQ_API_KEY = "gsk_..."
# In alternativa:
# PROVIDER = "gemini" / MODEL = "gemini-2.0-flash" / GOOGLE_API_KEY = "AIza..."   (free tier, se disponibile sul tuo account)
# PROVIDER = "openai" / MODEL = "gpt-4o-mini"       / OPENAI_API_KEY = "sk-..."    (a pagamento)
# PROVIDER = "anthropic" / MODEL = "claude-haiku-4-5" / ANTHROPIC_API_KEY = "sk-ant-..." (a pagamento)
