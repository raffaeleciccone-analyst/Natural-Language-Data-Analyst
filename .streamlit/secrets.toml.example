# --- Esempio di secrets per il deploy su Streamlit Community Cloud ---
# NON committare il vero secrets.toml (è già in .gitignore).
# Su Streamlit Cloud: app → Settings → Secrets → incolla queste righe con i valori reali.

# Attiva la modalità demo pubblica (provider/modello/chiave presi da qui,
# campi sensibili nascosti, limite di domande per sessione).
DEMO_MODE = "true"
DEMO_MAX_QUESTIONS = "15"

# Provider e modello economici consigliati per la demo:
PROVIDER = "openai"          # oppure "anthropic" / "gemini"
MODEL = "gpt-4o-mini"        # es. anthropic -> "claude-haiku-4-5", gemini -> "gemini-2.5-flash"

# Metti SOLO la chiave del provider scelto sopra:
OPENAI_API_KEY = "sk-..."
# ANTHROPIC_API_KEY = "sk-ant-..."
# GOOGLE_API_KEY = "AIza..."
