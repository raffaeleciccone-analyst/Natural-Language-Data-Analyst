# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Ambiente / segreti
.env

# Strumenti locali di sviluppo (impostazioni per-macchina, non parte del progetto)
.claude/
.vscode/
.idea/

# Cache degli strumenti di qualita'
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/   # database degli esempi di hypothesis (property test della sandbox)

# Streamlit
.streamlit/secrets.toml

# OS
.DS_Store
Thumbs.db

# Artefatti di coverage (pytest-cov): generati a ogni run, non versionati.
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Frontend (Node) ---
# node_modules si ricostruisce da package-lock.json: committarlo significherebbe
# migliaia di file e un repo che nessuno clona volentieri. Il LOCK invece si
# committa, ed e' cio' che rende riproducibile l'installazione.
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
