# Tutto ciò che non serve DENTRO l'immagine: riduce il contesto di build, i
# tempi e la superficie dell'immagine finale.

.git
.github
.gitignore

# Ambienti e cache locali
.venv
venv
__pycache__
*.py[cod]
*.egg-info
.mypy_cache
.pytest_cache
